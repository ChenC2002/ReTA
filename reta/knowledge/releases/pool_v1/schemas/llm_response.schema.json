{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ChenC2002/ReTA/main/reta/knowledge/releases/pool_v1/schemas/llm_response.schema.json",
  "title": "ReTA structured distillation response",
  "description": "Serialization contract for ReTA knowledge distillation responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition", "clinical_cascade"],
  "properties": {
    "definition": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence focused on pathology."
    },
    "clinical_cascade": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
