{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reta.local/schemas/pool_v1/distilled_artifact.schema.json",
  "title": "ReTA pool_v1 distilled artifact",
  "description": "JSONL record contract matching knowledge.templates.DistilledArtifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_id", "concept_name", "definition", "cascade", "meta"],
  "properties": {
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_name": {
      "type": "string"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "cascade": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meta": {
      "type": "object"
    }
  }
}
