{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reta.local/schemas/pool_v1/llm_response.schema.json",
  "title": "ReTA pool_v1 structured LLM response",
  "description": "Release-side serialization contract for the two fields required by the paper prompt. The paper does not publish a machine-readable response schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition", "clinical_cascade"],
  "properties": {
    "definition": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence focused on pathology."
    },
    "clinical_cascade": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
